---
import Home from "../../components/Home";
import {
  DEFAULT_OG_IMAGE,
  SITE_NAME,
  getHomeDescription,
  getHomeKeywords,
  getLocale,
  toAbsoluteUrl,
} from "../../site-meta";

const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID?.trim();
const googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION?.trim();
const lang = "zh";
const title = `${SITE_NAME} | 中文`;
const description = getHomeDescription(lang);
const keywords = getHomeKeywords(lang);
const canonicalUrl = toAbsoluteUrl("/zh/");
const alternateEnUrl = toAbsoluteUrl("/");
const ogImageUrl = toAbsoluteUrl(DEFAULT_OG_IMAGE);
const ogLocale = getLocale(lang);
const alternateLocale = 'en_US';
const gaInitScript = gaMeasurementId
  ? `window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());
gtag('config', '${gaMeasurementId}');`
  : '';
---

<!DOCTYPE html>
<html lang="zh">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="keywords" content={keywords} />
  <meta name="robots" content="index, follow, max-image-preview:large" />
  <meta name="author" content={SITE_NAME} />
  <meta name="theme-color" content="#050505" />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="alternate" hreflang="zh-CN" href={canonicalUrl} />
  <link rel="alternate" hreflang="en" href={alternateEnUrl} />
  <link rel="alternate" hreflang="x-default" href={alternateEnUrl} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:locale" content={ogLocale} />
  <meta property="og:locale:alternate" content={alternateLocale} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:alt" content={`${SITE_NAME} logo`} />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />
  {googleSiteVerification && (
    <meta name="google-site-verification" content={googleSiteVerification} />
  )}
  {gaMeasurementId && (
    <>
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}></script>
      <script is:inline set:html={gaInitScript}></script>
    </>
  )}
</head>
<body class="m-0 bg-black">
  <Home client:load lang="zh" />
</body>
</html>
