---
import CreatePage from "../../components/CreatePage";
import { DEFAULT_OG_IMAGE, SITE_NAME, toAbsoluteUrl } from "../../site-meta";

const title = `${SITE_NAME} | 创作`;
const description = "在 Lytai Studio 创作页中演示生成图片和视频的占位结果。";
const canonicalUrl = toAbsoluteUrl("/zh/create");
const alternateEnUrl = toAbsoluteUrl("/create");
const ogImageUrl = toAbsoluteUrl(DEFAULT_OG_IMAGE);
---

<!DOCTYPE html>
<html lang="zh">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="noindex, nofollow" />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="alternate" hreflang="zh-CN" href={canonicalUrl} />
  <link rel="alternate" hreflang="en" href={alternateEnUrl} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={ogImageUrl} />
</head>
<body class="m-0 bg-black">
  <CreatePage client:load lang="zh" />
</body>
</html>
